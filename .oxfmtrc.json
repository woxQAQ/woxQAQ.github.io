{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 80,
	"sortImports": true,
	"astro": true,
	"svelte": true,
	"ignorePatterns": [
		"**/*.css",
		"src/content/**",
		"src/public/**",
		"src/.excalidraw/**",
		"src/.obsidian/**",
		"dist/**",
		".astro/**",
		"node_modules/**"
	]
}
